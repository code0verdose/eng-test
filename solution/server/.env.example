DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guss
PORT=3000
# Длительность раунда и обратного отсчёта до старта, в секундах
ROUND_DURATION=60
COOLDOWN_DURATION=30
# Адрес фронтенда для CORS и cookie
CORS_ORIGIN=http://localhost:5173
# true за HTTPS-прокси
COOKIE_SECURE=false
# Время жизни сессии, в часах
SESSION_TTL_HOURS=24
# Сколько reverse proxy стоит перед приложением (0, если запросы приходят напрямую)
TRUST_PROXY_HOPS=0
